# Copy this file to .env and fill in your values

# Backend API URL
# Local: http://localhost:8000
# Production: http://YOUR_EC2_PUBLIC_IP:8000
REACT_APP_API_URL=http://localhost:8000

# Dashboard app URL (where users are redirected after login/signup)
# Local: http://localhost:3001
# Production: https://YOUR_DASHBOARD_CLOUDFRONT_URL.cloudfront.net
REACT_APP_DASHBOARD_URL=http://localhost:3001
