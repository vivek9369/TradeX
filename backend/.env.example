# Copy this file to .env and fill in your own values
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
PORT=8000
JWT_SECRET=your_super_secret_jwt_key_here

# For production: comma-separated list of allowed frontend origins
# Example: https://d1234abcd.cloudfront.net,https://d5678efgh.cloudfront.net
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
